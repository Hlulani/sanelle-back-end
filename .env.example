# Copy to .env (or export) to override the local defaults in application.properties.
DB_URL=jdbc:postgresql://localhost:5432/sanelle
DB_USERNAME=sanelle
DB_PASSWORD=sanelle

# HMAC signing key for JWTs, at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_COOKIE_SECURE=false

CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200,capacitor://localhost,http://localhost
